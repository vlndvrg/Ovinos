# Conexión MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eba_bienestar

# Seguridad
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-minimo-32-caracteres

# Recomendaciones con IA (Gemini)
# Obtenga una clave gratuita en Google AI Studio: https://aistudio.google.com/
# Deje GEMINI_API_KEY vacía si no desea usar recomendaciones generadas por IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest

# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
